# OpenRouter is the preferred chat provider. Keep credentials server-side.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o
OPENROUTER_MODELS=openai/gpt-4o,openai/gpt-4o-mini
OPENROUTER_HTTP_REFERER=https://ai-shadow-twin-by-encrypted.vercel.app
OPENROUTER_APP_TITLE=AI Shadow-Twin

# Optional direct OpenAI fallback.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Gemini is intentionally disabled for this build.
# GEMINI_API_KEY=
# GEMINI_MODEL=

# Prefer OpenRouter, then try direct OpenAI if configured.
CHAT_PROVIDER_ORDER=openrouter,openai

# System prompt for faculty chat
CHAT_SYSTEM_PROMPT=

# Provider request timeout in seconds
CHAT_TIMEOUT_S=30

# Local browser origins allowed to call the FastAPI service.
CORS_ALLOW_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174,http://localhost:4173,http://127.0.0.1:4173

