# Primary LLM API Key (Recommended)
# Set in Vercel Dashboard → Project Settings → Environment Variables
GEMINI_API_KEY=your_gemini_api_key_here

# Optional Model Configuration (defaults to gemini-2.0-flash)
# MODEL=gemini-2.0-flash
# GEMINI_MODEL=gemini-2.0-flash

# Optional Gemini Base URL (only needed if using a custom gateway/proxy)
# GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/

# OpenAI Configuration (Alternative provider if not using Gemini)
# OPENAI_API_KEY=your_openai_api_key_here
# OPENAI_MODEL=gpt-4o-mini

# Supabase Auth Configuration (Optional for mock auth testing)
# VITE_SUPABASE_URL=your_supabase_url_here
# VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here
