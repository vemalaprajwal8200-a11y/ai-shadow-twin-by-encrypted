# Primary LLM API Key (Recommended)
# Set in Vercel Dashboard → Project Settings → Environment Variables
GEMINI_API_KEY=your_gemini_api_key_here

# Optional Model Configuration (defaults to gemini-2.0-flash)
# MODEL=gemini-2.0-flash
# GEMINI_MODEL=gemini-2.0-flash

# Optional Gemini Base URL (only needed if using a custom gateway/proxy)
# GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/

# OpenAI Configuration (Alternative provider if not using Gemini)
# OPENAI_API_KEY=your_openai_api_key_here
# OPENAI_MODEL=gpt-4o-mini

# Frontend → FastAPI base URL (no secrets; keys stay on the backend)
VITE_API_BASE_URL=http://127.0.0.1:8000

# Public Supabase client values (Vite supports both prefixes in this project).
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here
# Alternatively use the requested NEXT_PUBLIC names:
# NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here
